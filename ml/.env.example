KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INPUT_TOPIC=feature_ready
KAFKA_OUTPUT_TOPIC=prediction_done
KAFKA_CONSUMER_GROUP=ml-svc-group
KAFKA_DLQ_TOPIC=prediction_dlq

PG_DSN=postgresql://postgres:postgres@postgres:5432/cartdb

MODEL_PATH_XGBOOST=./models/xgb_cart_abandonment.joblib
MODEL_VERSION_XGBOOST=xgboost-synthetic-mvp
ABANDON_THRESHOLD=0.5
SHAP_ENABLED=true
SHAP_TOP_N=10
