DJANGO_SECRET_KEY=change-me-main-service
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,main_service
FRONTEND_URL=http://localhost:3001

# PostgreSQL
DB_HOST=localhost
DB_NAME=cartdb
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# Optional observer DB alias. Leave blank to use the default DB.
OBSERVER_DB_HOST=
OBSERVER_DB_NAME=
OBSERVER_DB_USER=
OBSERVER_DB_PASSWORD=
OBSERVER_DB_PORT=5432

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Kafka prediction bridge
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PREDICTION_DONE_TOPIC=prediction_done
KAFKA_CONSUMER_GROUP=main-service-predictions

# Demo tenant used by the thesis MVP stack.
DEMO_TENANT_EXTERNAL_ID=00000000-0000-0000-0000-000000000001
DEMO_TENANT_NAME=Thesis Demo Store
DEMO_TENANT_DOMAIN=demo.local
DEMO_ADMIN_EMAIL=demo@example.com
DEMO_ADMIN_PASSWORD=change-me-demo-password
DEMO_OBSERVER_API_KEY=tk_full_demo_mvp

# Optional services
DUCKDB_PATH=/data/duckdb/analytics.duckdb
GEMINI_API_KEY=
