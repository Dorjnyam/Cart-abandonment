DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Primary DB (preferred)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/main_service

# Optional split config (used if DATABASE_URL is empty)
DB_HOST=
DB_NAME=main_service
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# Session/observer source DB alias
OBSERVER_DB_HOST=
OBSERVER_DB_NAME=
OBSERVER_DB_USER=
OBSERVER_DB_PASSWORD=
OBSERVER_DB_PORT=5432

# Celery broker
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Kafka prediction bridge
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PREDICTION_DONE_TOPIC=prediction_done
KAFKA_CONSUMER_GROUP=main-service-predictions
KAFKA_TASK_TIMEOUT_SECONDS=30

# DuckDB analytics store
DUCKDB_PATH=/data/duckdb/analytics.duckdb

# MinIO/S3 export
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=analytics-exports
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false

# LLM
GEMINI_API_KEY=
