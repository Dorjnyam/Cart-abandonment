# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Rotate credentials before deploying.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/observer_experiment

# ── Optional fan-outs (leave blank to disable) ────────────────────────────────
# Kafka broker address(es), comma-separated
KAFKA_BOOTSTRAP_SERVERS=

# Redis URL for downstream fan-out queues
REDIS_URL=

# HTTP endpoint of the Session Service
SESSION_SERVICE_URL=
SESSION_SERVICE_API_KEY=
SESSION_SERVICE_TIMEOUT_MS=1500

# ── Auth & CORS ───────────────────────────────────────────────────────────────
# Comma-separated allowed CORS origins. Must be set — no wildcard default.
OBSERVER_CORS_ORIGINS=http://localhost:3000

# Comma-separated full API key strings for allowlist mode.
# When unset, any key with a valid tk_basic_/tk_smart_/tk_full_ prefix is accepted (dev mode).
OBSERVER_API_KEYS=

# Secret for admin endpoints (/query, /clear). Leave blank to disable admin endpoints.
OBSERVER_ADMIN_KEY=

# ── Tuning (optional — defaults are shown) ────────────────────────────────────
# DB pool sizes
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# Kafka request timeout in ms
# KAFKA_REQUEST_TIMEOUT_MS=5000
