DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cartdb
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_URL=redis://localhost:6379/0

# HTTP fan-out to Session service.
SESSION_SERVICE_URL=http://localhost:8002/ingest/raw-event
SESSION_SERVICE_API_KEY=
SESSION_SERVICE_TIMEOUT_MS=1500

# CORS and API key allowlist.
OBSERVER_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
OBSERVER_API_KEYS=tk_full_demo_mvp
OBSERVER_ADMIN_KEY=

# Optional tuning.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
KAFKA_REQUEST_TIMEOUT_MS=5000
