# ── Kafka ─────────────────────────────────────────────────────────────────────
# Accepts both names for compatibility with Observer (which sets KAFKA_BOOTSTRAP_SERVERS)
KAFKA_BOOTSTRAP=kafka:9092
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

RAW_EVENTS_TOPIC=raw_events
SESSION_ENRICHED_TOPIC=session_enriched
SESSION_CONSUMER_GROUP=session-svc-group

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Used by docker-compose to set the Postgres superuser password
POSTGRES_PASSWORD=CHANGE_ME
PG_DSN=postgresql://postgres:CHANGE_ME@db:5432/cartdb

# ── Session behaviour ──────────────────────────────────────────────────────────
# How long a session lives without a new event before being finalized (seconds)
SESSION_TTL_SECONDS=1800

# bot_score threshold above which events are discarded
BOT_THRESHOLD=0.7

# kafka | http | both
# kafka-only: disable the HTTP ingest endpoint (SESSION_EVENT_SOURCE=kafka)
# http-only:  disable the Kafka consumer loop (SESSION_EVENT_SOURCE=http)
# both:       enable both paths + deduplication via event_id
SESSION_EVENT_SOURCE=both

# Set to 1/true to deduplicate by event_id when both Kafka and HTTP paths are active
SESSION_DEDUPE_EVENT_ID=1

# Window snapshot intervals in seconds (comma-separated)
SESSION_WINDOWS=30,60,90

# UUID used as tenant_id when Observer events omit it (single-tenant deployments)
SESSION_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# ── Optional HTTP ingest auth ──────────────────────────────────────────────────
# Must match Observer SESSION_SERVICE_API_KEY if set
# SESSION_INGEST_API_KEY=

# ── Backpressure ───────────────────────────────────────────────────────────────
REDIS_MEMORY_LIMIT_BYTES=536870912
BACKPRESSURE_SLEEP_SEC=0.5
